# Copy to .env and replace every value. Never commit .env.

# Database password used by the db and api containers.
POSTGRES_PASSWORD=change-me-postgres-password

# Port where the web app is published on the host.
WEB_PORT=8080

# Browsers accept Secure cookies on http://localhost. Set to false only when serving plain HTTP on another host.
AUTH_COOKIE_SECURE=true

# Set to true to expose the API documentation at http://localhost:8080/swagger.
SWAGGER_ENABLED=false

# Login/registration attempts per minute and IP. Raise it only for automated end-to-end runs.
AUTH_RATE_LIMIT_PER_MINUTE=10

# E-mail (password reset and reminder e-mails). Disabled: both features report "not available".
# Smtp: real delivery. Pickup: writes .eml files inside the container (testing only).
EMAIL_MODE=Disabled
EMAIL_FROM=HabitFlow <no-reply@example.com>
PUBLIC_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Password for the optional demo account (docker compose run --rm -e ASPNETCORE_ENVIRONMENT=Demo api seed-demo).
DEMO_PASSWORD=
